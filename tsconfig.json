{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["react-native", "jest"],
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "android/app/src/**/*",
    "App.tsx",
    "index.js",
    "__tests__/**/*"
, "src/components/DiffViewer", "src/components/RequestCard.tsx", "src/components/RiskBadge.tsx", "src/constants/colors.ts", "src/navigation", "src/store", "src/types", "src/screens/Auth", "src/screens/History", "src/screens/Requests"  ],
  "exclude": [
    "node_modules"
  ]
}
